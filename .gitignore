# AI config — managed in the private ai-config repo, never committed here
.ai-config.json
CLAUDE.md
.claude/settings.json
AGENTS.md
.codex/config.toml
.github/copilot-instructions.md
# Every folder that needs ignoring is a dot-folder, and the .*/ line below
# ignores them all, at any depth. A dot-folder the repo tracks gets a ! line
# here. Never add a line for a single dot-folder: .*/ already covers it.
.*/
!.github/
!.changeset/
!.vscode/
.vscode/*
!.vscode/extensions.json
!.brock/
.brock/profile-config.json
node_modules/
dist/
release/
.brock-port-slot
**/build/installer-splash.png

.mcp.json
!apps/desktop/.brock/
# brock sync: generated icon files, start. Brock rewrites the lines up to the end marker.
apps/desktop/build/icons/
apps/desktop/build/filetypes/
apps/desktop/build/splash/
apps/desktop/public/logos/icon.svg
apps/desktop/public/logos/icon.ico
apps/desktop/public/logos/icon-256.png
apps/desktop/public/logos/icon-32.png
apps/desktop/public/logos/icon-24.png
apps/desktop/public/logos/icon-bot.svg
apps/desktop/public/logos/icon-bot.ico
apps/desktop/public/logos/icon-bot-256.png
apps/desktop/public/logos/mark.svg
# brock sync: generated icon files, end.

# e2e export output folders
e2e-out-*/
