{
  "name": "bxel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@drizztdourden08/brock-build": "^0.83.0",
    "@drizztdourden08/brock-lint-config": "^0.83.0",
    "@drizztdourden08/brock-thread": "^0.83.0",
    "jscpd": "^4.0.5",
    "knip": "^5.65.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input && brock prose && brock knip && jscpd .",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "prose": "brock prose",
    "deadcode": "brock knip",
    "duplicates": "jscpd .",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "postinstall": "node bin/bxel.mjs --link"
  },
  "brock": {
    "version": "0.83.0"
  },
  "packageManager": "pnpm@10.17.0",
  "bin": {
    "bxel": "./bin/bxel.mjs"
  }
}
