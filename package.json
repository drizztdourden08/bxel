{
  "name": "bxel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@drizztdourden08/brock-build": "^0.118.2",
    "@drizztdourden08/brock-lint-config": "^0.118.2",
    "@drizztdourden08/brock-thread": "^0.118.2",
    "@drizztdourden08/standards": "^0.14.0",
    "jscpd": "catalog:",
    "knip": "^5.65.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "lint": "brock lint && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input",
    "lint:all": "brock lint --all && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input && brock prose && brock knip && jscpd . && pnpm run structure:check",
    "lint:packages": "pnpm -r --filter \"./packages/*\" run lint && brock knip",
    "lint:md": "markdownlint-cli2",
    "structure:check": "brock structure --check",
    "prose": "brock prose",
    "deadcode": "brock knip",
    "duplicates": "jscpd .",
    "test": "standards test",
    "test:pr": "standards test pr",
    "test:e2e": "standards test e2e --config vitest.e2e.config.ts",
    "bench": "vitest bench --run",
    "postinstall": "node bin/bxel.mjs --link",
    "structure": "brock structure --check"
  },
  "brock": {
    "version": "0.118.2"
  },
  "packageManager": "pnpm@10.17.0",
  "bin": {
    "bxel": "./bin/bxel.mjs"
  }
}
