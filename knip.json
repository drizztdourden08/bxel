{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [],
  "workspaces": {
    ".": {
      "entry": [
        ".markdownlint-cli2.mjs",
        "brock.workspace.mjs",
        "eslint.config.mjs",
        "stylelint.config.mjs"
      ],
      "project": [
        "*.{mjs,ts}"
      ],
      "ignoreBinaries": [
        "eslint",
        "stylelint",
        "markdownlint-cli2"
      ]
    },
    "apps/desktop": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "src/main.tsx",
        "src/helper/main.ts",
        "src/ipc/contract.type.ts",
        "src/screens/**/*.custom.tsx",
        "src/views/*/*.usage.ts",
        ".brock/*.ts",
        "*.config.{cjs,ts,mjs}",
        "brock.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        ".brock/*.ts"
      ],
      "ignoreDependencies": [
        "axe-core"
      ]
    }
  }
}
