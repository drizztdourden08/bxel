{
  "name": "bxel",
  "version": "0.1.0",
  "private": true,
  "description": "A blank Brock app.",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "brock dev",
    "build": "brock build",
    "package": "brock package",
    "start": "brock start",
    "start:headless": "brock start -- --no-focus --muted",
    "sync": "brock sync",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && eslint . && stylelint \"src/**/*.css\" && brock prose && brock knip && jscpd .",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "deadcode": "brock knip",
    "duplicates": "jscpd ."
  },
  "dependencies": {
    "@bxel/document": "workspace:*",
    "@bxel/formats": "workspace:*",
    "@bxel/palette": "workspace:*",
    "@bxel/raster": "workspace:*",
    "@drizztdourden08/brock-core": "^0.76.0",
    "@drizztdourden08/brock-electron": "^0.76.0",
    "@drizztdourden08/brock-react": "^0.76.0",
    "@drizztdourden08/brock-updater": "^0.76.0",
    "@drizztdourden08/tessera": "catalog:",
    "@electron-toolkit/utils": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "velopack": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@drizztdourden08/brock-build": "^0.76.0",
    "@drizztdourden08/brock-lint-config": "^0.76.0",
    "@drizztdourden08/brock-thread": "^0.76.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "brock": {
    "version": "0.76.0",
    "tessera": "0.52.0"
  }
}
